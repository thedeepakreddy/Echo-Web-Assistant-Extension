{
  "manifest_version": 3,
  "name": "ECHO Online",
  "version": "2.0.0",
  "description": "ECHO — autonomous browser assistant with a local-first brain. Most work happens on-device, so your API quota lasts.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "commands",
    "downloads",
    "contextMenus",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_title": "Open ECHO Online"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["speech.html", "approval.html", "characters/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "omnibox": {
    "keyword": "echo"
  },
  "commands": {
    "wake-echo": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Wake ECHO"
    },
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open ECHO chat panel"
    },
    "command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open ECHO command input on the page"
    }
  }
}
